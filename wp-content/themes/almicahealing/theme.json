{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "dark-green", "name": "Verde oscuro", "color": "#263B33" },
				{ "slug": "cream", "name": "Crema", "color": "#F8F5F0" },
				{ "slug": "gold", "name": "Dorado", "color": "#C3A36A" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Athelas",
					"fontFamily": "Athelas, Georgia, 'Times New Roman', serif"
				},
				{
					"slug": "body",
					"name": "Kumbh Sans",
					"fontFamily": "'Kumbh Sans', system-ui, sans-serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "#F8F5F0",
			"text": "#263B33"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)"
		},
		"elements": {
			"h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } },
			"h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } },
			"h3": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } }
		}
	}
}
