{
	"name": "almicahealing-theme",
	"private": true,
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "npm-run-all -p dev:*",
		"dev:css": "tailwindcss -i src/css/app.css -o build/app.css --watch",
		"dev:js": "esbuild src/js/app.js --bundle --outdir=build --watch",
		"build": "npm run build:css && npm run build:js",
		"build:css": "tailwindcss -i src/css/app.css -o build/app.css --minify",
		"build:js": "esbuild src/js/app.js --bundle --minify --outdir=build"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"npm-run-all": "^4.1.5",
		"tailwindcss": "^3.4.0"
	}
}
